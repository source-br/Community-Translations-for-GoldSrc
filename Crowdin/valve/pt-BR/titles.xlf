      <trans-unit id="s000076" resname="HZMOVE">
        <source xml:space="preserve">MOVE FORWARD BY PRESSING FORWARD KEY
MOVE BACKWARD BY PRESSING BACKWARD KEY
MOVE LEFT BY PRESSING MOVELEFT
MOVE RIGHT BY PRESSING MOVERIGHT
</source>
        <target state="translated">MOVA-SE PARA FRENTE PRESIONANDO A TECLA AVANÇAR
MOVA-SE PARA TRÁS PRESIONANDO A TECLA RECUAR
MOVA-SE PARA ESQUERDA PRESIONANDO A TECLA MOVERESQ
MOVA-SE PARA DIREITA PRESIONANDO A TECLA MOVERDIR</target>
        <note>GoldSrc identifier: HZMOVE</note>
      </trans-unit>
      <trans-unit id="s000077" resname="HZJUMP">
        <source xml:space="preserve">PRESS FORWARD KEY TO RUN FORWARD
PRESS JUMP KEY TO JUMP
</source>
        <target state="translated">PRESSIONE A TECLA AVANÇAR PARA CORRER PARA FRENTE
PRESSIONE A TECLA PULAR PARA SALTAR</target>
        <note>GoldSrc identifier: HZJUMP</note>
      </trans-unit>
      <trans-unit id="s000078" resname="HZDUCK">
        <source xml:space="preserve">PRESS FORWARD KEY TO RUN FORWARD
PRESS DUCK KEY TO DUCK
PRESS FORWARD + DUCK KEYS TOGETHER 
TO MOVE IN STEALTH MODE
</source>
        <target state="translated">PRESSIONE A TECLA AVANÇAR PARA CORRER PARA FRENTE
PRESSIONE A TECLA AGACHAR PARA SE ABAIXAR
PRESSIONE AS TECLAS AVANÇAR + AGACHAR
PARA SE MOVER EM SILÊNCIO</target>
        <note>GoldSrc identifier: HZDUCK</note>
      </trans-unit>
      <trans-unit id="s000079" resname="HZCOMBO">
        <source xml:space="preserve">PRESS FORWARD KEY TO RUN FORWARD
PRESS JUMP KEY TO JUMP
PRESS DUCK KEY TO DUCK
PRESS JUMP KEY TO JUMP
</source>
        <target state="translated">PRESSIONE A TECLA AVANÇAR PARA CORRER
PRESSIONE A TECLA PULAR PARA SALTAR
PRESSIONE A TECLA AGACHAR PARA SE ABAIXAR
PRESSIONE A TECLA PULAR PARA SALTAR NOVAMENTE</target>
        <note>GoldSrc identifier: HZCOMBO</note>
      </trans-unit>
      <trans-unit id="s000080" resname="HZDUCKJUMP">
        <source xml:space="preserve">PRESS FORWARD + JUMP TOGETHER,
THEN THE DUCK KEY
</source>
        <target state="translated">PRESSIONE AS TECLAS AVANÇAR + PULAR,
E, DEPOIS, A TECLA AGACHAR</target>
        <note>GoldSrc identifier: HZDUCKJUMP</note>
      </trans-unit>
      <trans-unit id="s000081" resname="HZLADDER">
        <source xml:space="preserve">PRESS FORWARD KEY TO MOVE UP LADDERS
PRESS BACKWARD KEY TO MOVE DOWN LADDERS
</source>
        <target state="translated">PRESSIONE A TECLA AVANÇAR PARA SUBIR ESCADAS
PRESSIONE A TECLA RECUAR PARA DESCER ESCADAS
</target>
        <note>GoldSrc identifier: HZLADDER</note>
      </trans-unit>
      <trans-unit id="s000082" resname="HZLJUMP">
        <source xml:space="preserve">WHILE MOVING FORWARD,
HOLD DOWN DUCK KEY--
THEN PRESS JUMP
</source>
        <target state="translated">ENQUANTO ANDA PARA FRENTE,
SEGURE A TECLA AGACHAR
E, ENTÃO, PRESSIONE PULAR</target>
        <note>GoldSrc identifier: HZLJUMP</note>
      </trans-unit>
